# Kurciv IPL 2027 — environment variables (all optional for local play)

# HTTP port for the API (and the built web app in production)
PORT=8787

# SQLite database file. Use :memory: for throwaway runs.
KURCIV_DB=./data/kurciv.db

# production enables the Secure flag on session cookies (requires HTTPS)
NODE_ENV=development

# Set to 1 when running behind a reverse proxy so client IPs (rate limiting) are correct
TRUST_PROXY=0

# Optional JSON manifest of licensed player portraits (see docs/DATA_SOURCES.md)
# KURCIV_IMAGE_MANIFEST=./data/images.json
