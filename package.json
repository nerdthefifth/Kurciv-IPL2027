{
  "name": "kurciv-ipl-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kurciv IPL 2027 — cricket management universe",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @kurciv/server\" \"npm run dev -w @kurciv/web\"",
    "build": "npm run build -w @kurciv/web",
    "start": "npm run start -w @kurciv/server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lab": "tsx tools/sim-lab.ts",
    "world-report": "tsx tools/world-report.ts",
    "validate-data": "tsx packages/data-ingestion/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
