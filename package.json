{
  "name": "kurciv-ipl-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kurciv IPL 2027 — cricket management universe",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kurciv/web",
    "build": "npm run build -w @kurciv/web",
    "preview": "npm run preview -w @kurciv/web",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lab": "tsx tools/sim-lab.ts",
    "world-report": "tsx tools/world-report.ts",
    "validate-data": "tsx packages/data-ingestion/src/cli.ts",
    "ingest": "tsx tools/ingest-cricsheet.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "22.10.2",
    "concurrently": "9.1.0",
    "fake-indexeddb": "^6.0.0",
    "fflate": "^0.8.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
